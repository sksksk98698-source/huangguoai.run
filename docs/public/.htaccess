# =======================================================================
# 黄果短剧AI指南 (huangguoai.run) - Apache 生产环境高性能配置文件 (.htaccess)
# =======================================================================

# ----------------------------------------------------------------------
# 1. 基础选项与重写引擎 (RewriteEngine & Clean URLs)
# ----------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1.0 统一规范主域名：www 强制 301 重定向至正式主域名 huangguoai.run
  RewriteCond %{HTTP_HOST} ^www\.huangguoai\.run$ [NC]
  RewriteRule ^(.*)$ https://huangguoai.run/$1 [L,R=301]

  # 1.1 强制全站 HTTPS 加密访问
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1.2 规范根域名或去除多余尾部斜杠 (如果不是真实物理目录，去掉尾部斜杠重定向规范化)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # 1.3 VitePress Clean URLs 伪静态规则映射 (无后缀路径重写为 .html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 1.4 目录首页解析 (访问 /dir/ 时指向 /dir/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

</IfModule>

# ----------------------------------------------------------------------
# 2. 自定义错误页面 (Custom Error Documents)
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# 3. 严格 MIME Types 定义 (尤其是 Pagefind WASM 与现代化 Web 资产)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .json .xml .svg .txt

  # 脚本与样式
  AddType text/html;charset=utf-8              .html
  AddType text/css                             .css
  AddType application/javascript               .js .mjs
  AddType application/json                     .json

  # WebAssembly (Pagefind 离线中文搜索依赖)
  AddType application/wasm                     .wasm

  # 字体
  AddType font/woff2                           .woff2
  AddType font/woff                            .woff
  AddType font/ttf                             .ttf
  AddType font/otf                             .otf

  # 图片与媒体
  AddType image/svg+xml                        .svg
  AddType image/webp                           .webp
  AddType image/avif                           .avif
  AddType image/x-icon                         .ico

  # 数据与配置
  AddType application/xml                      .xml
  AddType text/plain                           .txt
</IfModule>

# ----------------------------------------------------------------------
# 4. Gzip / Brotli 压缩配置 (mod_deflate)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  # 开启针对所有文本、脚本、样式与 WASM 的压缩
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf

  # 针对旧版浏览器做兼容
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ----------------------------------------------------------------------
# 5. 客户端长效缓存策略 (Browser Caching & Expires Headers)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML 页面：协商缓存，确保用户随时获取最新编译版本
  ExpiresByType text/html "access plus 0 seconds"

  # 带 Hash 签名的静态构建资产 (JS, CSS, WASM, 字体)：长效缓存 1 年 (immutable)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # 图片与多媒体资产
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # 数据文件 (Sitemap, Robots, JSON)
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

# 补充 Cache-Control Header
<IfModule mod_headers.c>
  # HTML 页面
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # 带哈希的静态资源文件
  <FilesMatch "\.(js|css|wasm|woff2|woff|ttf|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----------------------------------------------------------------------
  # 6. 企业级网络安全响应头 (Security Headers)
  # ----------------------------------------------------------------------
  # 防止 MIME 类型混淆嗅探攻击
  Header set X-Content-Type-Options "nosniff"

  # 防止点击劫持 (Clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"

  # 跨站脚本 XSS 防御 (现代浏览器已逐步整合至 CSP，此处作为兼容防线)
  Header set X-XSS-Protection "1; mode=block"

  # 限制 Referrer 泄漏策略
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # 权限控制策略
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # 严格传输安全 HSTS (强制一年内通过 HTTPS 访问)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
